+package llm
+
+import "testing"
+
+func TestPerformanceThreads(t *testing.T) {
+	tests := []struct {
+		name  string
+		freqs []int
+		want  int
+	}{
+		{name: "unknown", freqs: nil, want: 0},
+		// Snapdragon 8 Gen 2: 3x A510, 4x A715/A710, 1x X3
+		{name: "snapdragon 8 gen 2", freqs: []int{2016000, 2016000, 2016000, 2803200, 2803200, 2803200, 2803200, 3360000}, want: 4},
+		{name: "all cores equal", freqs: []int{2000000, 2000000, 2000000, 2000000}, want: 3},
+		{name: "single core", freqs: []int{1800000}, want: 1},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := performanceThreads(tt.freqs); got != tt.want {
+				t.Fatalf("performanceThreads() = %d, want %d", got, tt.want)
+			}
+		})
+	}
+}
