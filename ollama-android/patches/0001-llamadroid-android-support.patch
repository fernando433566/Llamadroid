+package llm
+
+import (
+	"slices"
+	"testing"
+)
+
+func TestAppendRPCArgs(t *testing.T) {
+	tests := []struct {
+		name string
+		raw  string
+		want []string
+	}{
+		{name: "disabled", raw: "", want: []string{"base"}},
+		{
+			name: "valid workers",
+			raw:  "192.168.1.20:50052, worker.local:6000",
+			want: []string{"base", "--rpc", "192.168.1.20:50052,worker.local:6000"},
+		},
+		{
+			name: "invalid entries are ignored",
+			raw:  "missing-port,host:0,host:70000,10.0.0.3:50052",
+			want: []string{"base", "--rpc", "10.0.0.3:50052"},
+		},
+		{
+			name: "ipv6",
+			raw:  "[fd00::42]:50052",
+			want: []string{"base", "--rpc", "[fd00::42]:50052"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := appendRPCArgs([]string{"base"}, tt.raw); !slices.Equal(got, tt.want) {
+				t.Fatalf("appendRPCArgs() = %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
diff --git a/llm/llama_server_threads_llamadroid.go b/llm/llama_server_threads_llamadroid.go
new file mode 100644
index 00000000..0cf036a3
--- /dev/null
+++ b/llm/llama_server_threads_llamadroid.go
@@ -0,0 +1,65 @@
+// Llamadroid: pick a sensible thread count on phones.
+//
+// Phone CPUs mix fast and slow cores (big.LITTLE). llama.cpp uses one thread
+// per core by default, so the slow cores hold everyone back: on a Snapdragon
+// 8 Gen 2, 8 threads generate ~10 tok/s while 4 threads reach ~16-28 tok/s.
+
+package llm
+
+import (
+	"os"
+	"path/filepath"
+	"runtime"
+	"strconv"
+	"strings"
+)
+
+// androidDefaultThreads returns the number of threads to use on Android, or 0
+// to keep llama.cpp's default (other platforms, or when it cannot tell).
+func androidDefaultThreads() int {
+	if runtime.GOOS != "android" {
+		return 0
+	}
+	return performanceThreads(readCoreMaxFrequencies("/sys/devices/system/cpu"))
+}
+
+// performanceThreads counts the cores that are not in the slowest cluster and
+// keeps one of them free for Android and the app's UI.
+func performanceThreads(maxFreqs []int) int {
+	if len(maxFreqs) == 0 {
+		return 0
+	}
+
+	slowest := maxFreqs[0]
+	for _, f := range maxFreqs {
+		slowest = min(slowest, f)
+	}
+
+	fast := 0
+	for _, f := range maxFreqs {
+		if f > slowest {
+			fast++
+		}
+	}
+	if fast == 0 {
+		// All cores are the same: use all but one.
+		fast = len(maxFreqs)
+	}
+	return max(fast-1, 1)
+}
+
+// readCoreMaxFrequencies reads cpuN/cpufreq/cpuinfo_max_freq for every core.
+func readCoreMaxFrequencies(cpuDir string) []int {
+	paths, _ := filepath.Glob(filepath.Join(cpuDir, "cpu[0-9]*", "cpufreq", "cpuinfo_max_freq"))
+	var freqs []int
+	for _, path := range paths {
+		data, err := os.ReadFile(path)
+		if err != nil {
+			continue
+		}
+		if f, err := strconv.Atoi(strings.TrimSpace(string(data))); err == nil {
+			freqs = append(freqs, f)
+		}
+	}
+	return freqs
+}
