+	devices = refineWindowsVulkanDevices(devices, libDirs)
+	return refineAndroidDevices(devices)
+}
+
+// refineAndroidDevices (Llamadroid) marks every phone GPU as integrated:
+// Adreno and Mali share the system RAM with the CPU, whether they are driven
+// through Vulkan or OpenCL.
+func refineAndroidDevices(devices []ml.DeviceInfo) []ml.DeviceInfo {
+	if runtime.GOOS != "android" {
+		return devices
+	}
+
+	for i := range devices {
+		devices[i].Integrated = true
+	}
+
+	return devices
 }
 
