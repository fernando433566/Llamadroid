diff --git a/server/sched_llamadroid.go b/server/sched_llamadroid.go
new file mode 100644
index 00000000..82d5a0fd
--- /dev/null
+++ b/server/sched_llamadroid.go
@@ -0,0 +1,78 @@
+// Llamadroid: scheduler behaviour that only applies when Ollama runs inside
+// the Android app. Everything here is a no-op on other platforms, so the
+// upstream scheduler keeps working unchanged on desktop builds.
+
+package server
+
+import (
+	"log/slog"
+	"runtime"
+
+	"github.com/ollama/ollama/fs/gguf"
+	"github.com/ollama/ollama/ml"
+)
+
+// Synergy mode lets the user pick "X % of the layers on the GPU, the rest on
+// the CPU". The Android app has no extra API field for this, so it encodes
+// the percentage in num_gpu:
+//
+//	num_gpu = -1000 - gpuPercent      (gpuPercent in 0..100)
+//
+// so -1000 means 0 % GPU (all CPU) and -1100 means 100 % GPU.
+const (
+	synergyEncodedMin = -1100 // 100 % GPU
+	synergyEncodedMax = -1000 // 0 % GPU
+)
+
+// androidSynergyGPULayers decodes a Synergy num_gpu value into the number of
+// layers to offload. ok is false when encoded is a normal num_gpu value.
+func androidSynergyGPULayers(encoded, totalLayers int) (gpuPercent, gpuLayers int, ok bool) {
+	if encoded > synergyEncodedMax || encoded < synergyEncodedMin || totalLayers < 0 {
+		return 0, 0, false
+	}
+
+	gpuPercent = synergyEncodedMax - encoded
+	gpuLayers = (totalLayers*gpuPercent + 50) / 100 // rounded to the nearest layer
+	return gpuPercent, min(max(gpuLayers, 0), totalLayers), true
+}
+
+// applyAndroidSynergyLayers replaces an encoded Synergy num_gpu with the real
+// layer count before Ollama plans the model placement.
+func applyAndroidSynergyLayers(req *LlmRequest, f *gguf.Model) {
+	if runtime.GOOS != "android" {
+		return
+	}
+
+	totalLayers := int(f.KV().BlockCount() + 1) // +1 for the output layer
+	gpuPercent, gpuLayers, ok := androidSynergyGPULayers(req.opts.NumGPU, totalLayers)
+	if !ok {
+		return
+	}
+
+	req.opts.NumGPU = gpuLayers
+	slog.Info("android synergy mode: splitting layers between CPU and GPU",
+		"model", req.model.ModelPath,
+		"gpu_percent", gpuPercent,
+		"gpu_layers", gpuLayers,
+		"total_layers", totalLayers)
+}
+
+// retryAndroidLoadOnCPU decides whether a failed load should be retried once
+// on the CPU. Mobile Vulkan drivers differ a lot between phones, so the GPU is
+// always tried first, but a driver crash should not make the model unusable.
+//
+// It only triggers for automatic placement (num_gpu < 0): if the user asked
+// for a specific number of GPU layers we respect that and report the error.
+func retryAndroidLoadOnCPU(req *LlmRequest, loadGpus []ml.DeviceInfo, err error) bool {
+	if runtime.GOOS != "android" || len(loadGpus) == 0 || req.opts.NumGPU >= 0 || req.gpuFallbackAttempted {
+		return false
+	}
+
+	req.gpuFallbackAttempted = true
+	req.opts.NumGPU = 0
+	slog.Warn("android GPU load failed; retrying once on CPU",
+		"model", req.model.ModelPath,
+		"gpu_library", loadGpus[0].Library,
+		"error", err)
+	return true
+}
