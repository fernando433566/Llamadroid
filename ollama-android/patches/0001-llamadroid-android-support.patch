+package discover
+
+import "testing"
+
+// Output of `llama-server --list-devices` on a Galaxy Z Flip5 (Snapdragon 8 Gen 2).
+func TestParseAndroidAdrenoDevices(t *testing.T) {
+	output := "Available devices:\n" +
+		"  Vulkan0: Adreno (TM) 740 (7429 MiB, 7429 MiB free)\n" +
+		"  GPUOpenCL: QUALCOMM Adreno(TM) (3586 MiB, 2562 MiB free)\n"
+
+	devices := parseLlamaServerDevicesWithNative(output, "", nil, nil)
+	if len(devices) != 2 {
+		t.Fatalf("got %d devices, want 2", len(devices))
+	}
+	if got := devices[1].Library; got != "OpenCL" {
+		t.Errorf("GPUOpenCL library = %q, want OpenCL", got)
+	}
+	if got := devices[1].FreeMemory; got != 2562*1024*1024 {
+		t.Errorf("GPUOpenCL free memory = %d, want %d", got, 2562*1024*1024)
+	}
+}
