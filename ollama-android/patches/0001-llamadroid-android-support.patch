diff --git a/llm/llama_server_rpc.go b/llm/llama_server_rpc.go
new file mode 100644
index 00000000..5521cbcc
--- /dev/null
+++ b/llm/llama_server_rpc.go
@@ -0,0 +1,36 @@
+// Llamadroid: lets several phones work as one "device cluster". Other devices
+// run ggml-rpc-server and this phone hands part of the model to them through
+// llama.cpp's RPC backend.
+
+package llm
+
+import (
+	"net"
+	"strconv"
+	"strings"
+)
+
+// appendRPCArgs adds "--rpc host:port,host:port" to the llama-server command
+// line from a comma separated list (the OLLAMA_RPC_SERVERS variable).
+//
+// Invalid entries are skipped instead of failing, so an old or mistyped
+// worker address saved in the app never stops local models from loading.
+func appendRPCArgs(params []string, raw string) []string {
+	var endpoints []string
+	for _, candidate := range strings.Split(raw, ",") {
+		host, port, err := net.SplitHostPort(strings.TrimSpace(candidate))
+		if err != nil || strings.TrimSpace(host) == "" {
+			continue
+		}
+		portNumber, err := strconv.Atoi(port)
+		if err != nil || portNumber < 1 || portNumber > 65535 {
+			continue
+		}
+		endpoints = append(endpoints, net.JoinHostPort(host, port))
+	}
+
+	if len(endpoints) == 0 {
+		return params
+	}
+	return append(params, "--rpc", strings.Join(endpoints, ","))
+}
